{
  "manifest_version": 3,
  "name": "Tab Monitor",
  "version": "2.1",
  "description": "实时把所有窗口的标签页状态推送到本机 127.0.0.1:8765",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
